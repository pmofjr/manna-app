<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manna 窶 Seu Devocional Personalizado</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #C9A84C;
    --gold-light: #E8D5A3;
    --blue: #1C3557;
    --blue-mid: #2E5480;
    --blue-dark: #0F1E2E;
    --white: #FFFFFF;
    --text: #FFFFFF;
    --text-muted: rgba(255,255,255,0.55);
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'DM Sans', sans-serif;
    --card-bg: rgba(255,255,255,0.05);
    --card-border: rgba(255,255,255,0.1);
    --gold-border: rgba(201,168,76,0.3);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--sans);
    background: var(--blue-dark);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* 笏笏 SCREENS 笏笏 */
  .screen { display: none; min-height: 100vh; }
  .screen.active { display: flex; flex-direction: column; }

  /* 笏笏 AUTH SCREEN 笏笏 */
  #screen-auth {
    align-items: center; justify-content: center;
    background: radial-gradient(ellipse at 60% 0%, rgba(201,168,76,0.12) 0%, transparent 60%),
                radial-gradient(ellipse at 10% 90%, rgba(46,84,128,0.5) 0%, transparent 60%),
                var(--blue-dark);
    padding: 40px 24px;
  }
  .auth-box {
    width: 100%; max-width: 400px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--card-border);
    border-radius: 24px;
    padding: 40px 36px;
    box-shadow: 0 40px 80px rgba(0,0,0,0.4);
  }
  .auth-logo {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    margin-bottom: 32px;
  }
  .auth-logo-text {
    font-family: var(--serif); font-size: 2rem; font-weight: 600;
    color: var(--white); letter-spacing: 0.04em;
  }
  .auth-logo-text span { color: var(--gold); }
  .auth-tabs {
    display: flex; background: rgba(255,255,255,0.04);
    border-radius: 12px; padding: 4px; margin-bottom: 28px;
  }
  .auth-tab {
    flex: 1; text-align: center; padding: 10px;
    font-size: 0.85rem; font-weight: 500; cursor: pointer;
    border-radius: 10px; color: var(--text-muted); transition: all 0.2s;
    border: none; background: none;
  }
  .auth-tab.active { background: var(--gold); color: var(--white); }
  .auth-form { display: flex; flex-direction: column; gap: 14px; }
  .auth-form input {
    background: rgba(255,255,255,0.06); border: 1px solid var(--card-border);
    border-radius: 12px; padding: 14px 16px; color: var(--white);
    font-family: var(--sans); font-size: 0.9rem; outline: none;
    transition: border-color 0.2s;
  }
  .auth-form input::placeholder { color: var(--text-muted); }
  .auth-form input:focus { border-color: var(--gold-border); }
  .btn-auth {
    background: var(--gold); color: var(--white);
    border: none; border-radius: 50px; padding: 14px;
    font-family: var(--sans); font-size: 0.95rem; font-weight: 500;
    cursor: pointer; transition: all 0.2s; margin-top: 4px;
    box-shadow: 0 6px 20px rgba(201,168,76,0.3);
  }
  .btn-auth:hover { background: var(--blue-mid); transform: translateY(-1px); }
  .auth-divider {
    display: flex; align-items: center; gap: 12px;
    margin: 8px 0; color: var(--text-muted); font-size: 0.8rem;
  }
  .auth-divider::before, .auth-divider::after {
    content: ''; flex: 1; height: 1px; background: var(--card-border);
  }
  .btn-google {
    background: rgba(255,255,255,0.06); border: 1px solid var(--card-border);
    border-radius: 50px; padding: 13px; color: var(--white);
    font-family: var(--sans); font-size: 0.9rem; font-weight: 500;
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .btn-google:hover { background: rgba(255,255,255,0.1); }
  .auth-note { text-align: center; font-size: 0.75rem; color: var(--text-muted); margin-top: 16px; }
  .auth-note a { color: var(--gold); text-decoration: none; }

  /* 笏笏 NAV 笏笏 */
  .app-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 5%;
    background: rgba(15,30,46,0.92); backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(201,168,76,0.12);
  }
  .app-nav-logo {
    display: flex; align-items: center; gap: 6px;
    font-family: var(--serif); font-size: 1.4rem; font-weight: 600; color: var(--white);
  }
  .app-nav-logo span { color: var(--gold); }
  .nav-actions { display: flex; align-items: center; gap: 16px; }
  .nav-icon-btn {
    background: none; border: none; cursor: pointer;
    color: var(--text-muted); font-size: 1.1rem; transition: color 0.2s;
    display: flex; align-items: center; gap: 6px;
    font-family: var(--sans); font-size: 0.82rem;
  }
  .nav-icon-btn:hover { color: var(--gold); }

  /* 笏笏 HOME SCREEN 笏笏 */
  #screen-home {
    background: radial-gradient(ellipse at 70% 0%, rgba(201,168,76,0.1) 0%, transparent 55%),
                var(--blue-dark);
    padding-top: 80px;
    align-items: center;
  }
  .home-inner {
    width: 100%; max-width: 560px;
    padding: 48px 24px;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 32px;
  }
  .home-greeting {
    font-size: 0.85rem; color: var(--text-muted); margin-bottom: -20px;
  }
  .home-title {
    font-family: var(--serif); font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 400; line-height: 1.3; color: var(--white);
  }
  .home-title em { font-style: italic; color: var(--gold); }
  .home-question {
    font-size: 0.95rem; color: var(--text-muted); margin-top: -16px;
  }

  /* trilha buttons */
  .trilha-btns { display: flex; flex-direction: column; gap: 14px; width: 100%; }
  .trilha-btn {
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 16px; padding: 20px 24px;
    display: flex; align-items: center; gap: 16px;
    cursor: pointer; transition: all 0.2s; text-align: left; width: 100%;
  }
  .trilha-btn:hover { background: rgba(255,255,255,0.08); border-color: var(--gold-border); transform: translateY(-2px); }
  .trilha-btn.selected { border-color: var(--gold); background: rgba(201,168,76,0.08); }
  .trilha-icon { font-size: 1.8rem; flex-shrink: 0; }
  .trilha-label { font-family: var(--serif); font-size: 1.1rem; color: var(--white); }
  .trilha-sub { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }

  /* 笏笏 BLESS NAME SCREEN 笏笏 */
  #screen-bless-name {
    background: var(--blue-dark);
    padding-top: 80px; align-items: center;
  }
  .step-inner {
    width: 100%; max-width: 520px; padding: 48px 24px;
    display: flex; flex-direction: column; gap: 28px;
  }
  .step-back {
    background: none; border: none; color: var(--text-muted);
    cursor: pointer; font-size: 0.85rem; display: flex; align-items: center; gap: 6px;
    font-family: var(--sans); transition: color 0.2s; align-self: flex-start;
  }
  .step-back:hover { color: var(--gold); }
  .step-title { font-family: var(--serif); font-size: clamp(1.5rem, 3.5vw, 2rem); color: var(--white); line-height: 1.3; }
  .step-title em { font-style: italic; color: var(--gold); }
  .step-sub { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-top: -12px; }
  .step-input {
    background: rgba(255,255,255,0.06); border: 1px solid var(--card-border);
    border-radius: 14px; padding: 16px 20px; color: var(--white);
    font-family: var(--serif); font-size: 1.2rem; outline: none;
    transition: border-color 0.2s; width: 100%;
  }
  .step-input::placeholder { color: var(--text-muted); font-family: var(--sans); font-size: 0.9rem; }
  .step-input:focus { border-color: var(--gold-border); }
  .btn-next {
    background: var(--gold); color: var(--white); border: none;
    border-radius: 50px; padding: 16px 36px; font-family: var(--sans);
    font-size: 0.95rem; font-weight: 500; cursor: pointer;
    transition: all 0.2s; box-shadow: 0 6px 20px rgba(201,168,76,0.3);
    align-self: flex-start;
  }
  .btn-next:hover { background: var(--blue-mid); transform: translateY(-1px); }
  .btn-next:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

  /* 笏笏 EMOTION SCREEN 笏笏 */
  #screen-emotion {
    background: var(--blue-dark); padding-top: 80px; align-items: center;
  }
  .emotion-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; width: 100%;
  }
  .emotion-btn {
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 14px; padding: 18px 16px;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    cursor: pointer; transition: all 0.2s; text-align: center;
  }
  .emotion-btn:hover { background: rgba(255,255,255,0.08); border-color: var(--gold-border); transform: translateY(-2px); }
  .emotion-btn.selected { border-color: var(--gold); background: rgba(201,168,76,0.08); }
  .emotion-icon { font-size: 1.8rem; }
  .emotion-label { font-family: var(--serif); font-size: 1rem; color: var(--white); }

  /* 笏笏 CAUSE SCREEN 笏笏 */
  #screen-cause {
    background: var(--blue-dark); padding-top: 80px; align-items: center;
  }
  .cause-list { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .cause-btn {
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 14px; padding: 16px 20px;
    display: flex; align-items: center; gap: 14px;
    cursor: pointer; transition: all 0.2s; text-align: left;
  }
  .cause-btn:hover { background: rgba(255,255,255,0.08); border-color: var(--gold-border); }
  .cause-btn.selected { border-color: var(--gold); background: rgba(201,168,76,0.08); }
  .cause-icon { font-size: 1.4rem; flex-shrink: 0; }
  .cause-label { font-family: var(--serif); font-size: 1rem; color: var(--white); }

  /* 笏笏 LOADING SCREEN 笏笏 */
  #screen-loading {
    background: radial-gradient(ellipse at 50% 30%, rgba(201,168,76,0.1) 0%, transparent 60%), var(--blue-dark);
    align-items: center; justify-content: center; padding: 40px 24px;
  }
  .loading-inner { text-align: center; max-width: 400px; }
  .loading-wheat {
    width: 64px; height: 64px; margin: 0 auto 32px;
    animation: sway 2s ease-in-out infinite;
  }
  @keyframes sway {
    0%, 100% { transform: rotate(-5deg); }
    50% { transform: rotate(5deg); }
  }
  .loading-title {
    font-family: var(--serif); font-size: 1.6rem; color: var(--white);
    font-style: italic; margin-bottom: 12px; line-height: 1.4;
  }
  .loading-sub { font-size: 0.88rem; color: var(--text-muted); margin-bottom: 40px; }
  .loading-bar {
    width: 100%; height: 2px; background: rgba(255,255,255,0.08);
    border-radius: 2px; overflow: hidden;
  }
  .loading-bar-fill {
    height: 100%; background: var(--gold); border-radius: 2px;
    animation: loadfill 3s ease-in-out forwards;
  }
  @keyframes loadfill { from { width: 0%; } to { width: 95%; } }
  .loading-dots { display: flex; justify-content: center; gap: 8px; margin-top: 24px; }
  .loading-dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--gold);
    animation: dotpulse 1.4s ease-in-out infinite;
  }
  .loading-dot:nth-child(2) { animation-delay: 0.2s; }
  .loading-dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dotpulse { 0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); } 40% { opacity: 1; transform: scale(1); } }

  /* 笏笏 DEVOTIONAL SCREEN 笏笏 */
  #screen-devotional {
    background: var(--blue-dark); padding-top: 80px; align-items: center;
  }
  .devo-inner {
    width: 100%; max-width: 680px; padding: 40px 24px 80px;
  }
  .devo-meta {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 32px; flex-wrap: wrap; gap: 12px;
  }
  .devo-date { font-size: 0.78rem; color: var(--text-muted); letter-spacing: 0.06em; text-transform: uppercase; }
  .devo-emotion-tag {
    background: rgba(201,168,76,0.12); border: 1px solid var(--gold-border);
    color: var(--gold-light); font-size: 0.75rem; padding: 4px 12px; border-radius: 50px;
  }
  .devo-content {
    background: rgba(255,255,255,0.03); border: 1px solid var(--card-border);
    border-radius: 20px; padding: 40px 36px;
  }
  .devo-greeting {
    font-family: var(--serif); font-size: 1.05rem;
    color: var(--gold-light); font-style: italic; margin-bottom: 24px;
  }
  .devo-text {
    font-size: 0.97rem; line-height: 1.85; color: rgba(255,255,255,0.82);
  }
  .devo-text p { margin-bottom: 18px; }
  .devo-verse {
    background: rgba(201,168,76,0.08); border-left: 3px solid var(--gold);
    border-radius: 0 12px 12px 0; padding: 20px 24px; margin: 28px 0;
  }
  .devo-verse-text {
    font-family: var(--serif); font-size: 1.05rem; font-style: italic;
    color: var(--gold-light); line-height: 1.6; margin-bottom: 8px;
  }
  .devo-verse-ref { font-size: 0.75rem; color: var(--gold); text-transform: uppercase; letter-spacing: 0.06em; }
  .devo-prayer {
    background: rgba(28,53,87,0.5); border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px; padding: 24px; margin-top: 28px;
  }
  .devo-prayer-label {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--gold); margin-bottom: 14px; font-weight: 500;
  }
  .devo-prayer-text {
    font-family: var(--serif); font-size: 0.97rem; font-style: italic;
    color: rgba(255,255,255,0.75); line-height: 1.7;
  }
  .devo-actions {
    display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap;
  }
  .devo-action-btn {
    display: flex; align-items: center; gap: 8px;
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 50px; padding: 11px 20px;
    font-family: var(--sans); font-size: 0.82rem; color: var(--text-muted);
    cursor: pointer; transition: all 0.2s;
  }
  .devo-action-btn:hover { background: rgba(255,255,255,0.1); color: var(--white); border-color: rgba(255,255,255,0.2); }
  .devo-action-btn.whatsapp { background: rgba(37,211,102,0.1); border-color: rgba(37,211,102,0.3); color: #25D366; }
  .devo-action-btn.whatsapp:hover { background: rgba(37,211,102,0.2); }

  /* 笏笏 HISTORY SCREEN 笏笏 */
  #screen-history {
    background: var(--blue-dark); padding-top: 80px; align-items: center;
  }
  .history-inner { width: 100%; max-width: 680px; padding: 40px 24px; }
  .history-title { font-family: var(--serif); font-size: 1.8rem; color: var(--white); margin-bottom: 8px; }
  .history-sub { font-size: 0.88rem; color: var(--text-muted); margin-bottom: 32px; }
  .history-list { display: flex; flex-direction: column; gap: 12px; }
  .history-item {
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 14px; padding: 20px 24px;
    display: flex; align-items: center; justify-content: space-between;
    cursor: pointer; transition: all 0.2s;
  }
  .history-item:hover { background: rgba(255,255,255,0.08); border-color: var(--gold-border); }
  .history-item-left { display: flex; align-items: center; gap: 14px; }
  .history-item-icon { font-size: 1.4rem; }
  .history-item-date { font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .history-item-emotion { font-family: var(--serif); font-size: 1rem; color: var(--white); margin-top: 2px; }
  .history-item-arrow { color: var(--text-muted); font-size: 0.8rem; }

  /* 笏笏 TOASTS 笏笏 */
  .toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    background: var(--blue-mid); border: 1px solid var(--gold-border);
    color: var(--white); font-size: 0.85rem; padding: 12px 24px;
    border-radius: 50px; z-index: 999; opacity: 0; pointer-events: none;
    transition: opacity 0.3s; white-space: nowrap;
  }
  .toast.show { opacity: 1; }

  /* 笏笏 ERROR 笏笏 */
  .error-msg {
    background: rgba(220,50,50,0.1); border: 1px solid rgba(220,50,50,0.3);
    color: #ff8080; font-size: 0.82rem; padding: 10px 14px;
    border-radius: 10px; display: none;
  }
  .error-msg.show { display: block; }

  /* 笏笏 RESPONSIVE 笏笏 */
  @media (max-width: 480px) {
    .auth-box { padding: 32px 24px; }
    .devo-content { padding: 28px 22px; }
    .emotion-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
<body>

<!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
<!--  SCREEN: AUTH                      -->
<!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
<div id="screen-auth" class="screen active">
  <div class="auth-box">
    <div class="auth-logo">
      <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
        <line x1="20" y1="38" x2="20" y2="8" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round"/>
        <ellipse cx="20" cy="7" rx="3.5" ry="5.5" fill="#C9A84C" opacity="0.9"/>
        <ellipse cx="14.5" cy="13" rx="3" ry="5" fill="#C9A84C" opacity="0.75" transform="rotate(-28 14.5 13)"/>
        <ellipse cx="12" cy="21" rx="2.8" ry="4.5" fill="#C9A84C" opacity="0.6" transform="rotate(-22 12 21)"/>
        <ellipse cx="25.5" cy="13" rx="3" ry="5" fill="#C9A84C" opacity="0.75" transform="rotate(28 25.5 13)"/>
        <ellipse cx="28" cy="21" rx="2.8" ry="4.5" fill="#C9A84C" opacity="0.6" transform="rotate(22 28 21)"/>
        <path d="M20 28 Q13 24 11 17" stroke="#C9A84C" stroke-width="1.2" fill="none" stroke-linecap="round" opacity="0.5"/>
        <path d="M20 28 Q27 24 29 17" stroke="#C9A84C" stroke-width="1.2" fill="none" stroke-linecap="round" opacity="0.5"/>
      </svg>
      <span class="auth-logo-text">Mann<span>a</span></span>
    </div>

    <div class="auth-tabs">
      <button class="auth-tab active" onclick="switchAuthTab('login')">Entrar</button>
      <button class="auth-tab" onclick="switchAuthTab('register')">Criar conta</button>
    </div>

    <div id="auth-login">
      <div class="auth-form">
        <input type="email" id="login-email" placeholder="Seu e-mail" autocomplete="email">
        <input type="password" id="login-password" placeholder="Sua senha" autocomplete="current-password">
        <div class="error-msg" id="login-error"></div>
        <button class="btn-auth" onclick="handleLogin()">Entrar</button>
      </div>
    </div>

    <div id="auth-register" style="display:none">
      <div class="auth-form">
        <input type="text" id="register-name" placeholder="Seu nome" autocomplete="name">
        <input type="email" id="register-email" placeholder="Seu e-mail" autocomplete="email">
        <input type="password" id="register-password" placeholder="Crie uma senha" autocomplete="new-password">
        <div class="error-msg" id="register-error"></div>
        <button class="btn-auth" onclick="handleRegister()">Criar conta</button>
      </div>
    </div>

    <p class="auth-note">Ao continuar, vocﾃｪ concorda com os <a href="#">Termos de Uso</a> e <a href="#">Polﾃｭtica de Privacidade</a></p>
  </div>
</div>

<!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
<!--  NAV (shared)                      -->
<!-- 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武 -->
<nav class="app-nav" id="app-nav" style="display:none">
  <div class="app-nav-logo">
    <svg width="26" height="26" viewBox="0 0 40 40" fill="none">
